<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Vehicle Types -->
    <vType id="passenger" accel="2.6" decel="4.5" sigma="0.5" length="4.5" maxSpeed="13.89" color="1,1,0"/>
    <vType id="emergency" accel="3.5" decel="6.0" sigma="0.1" length="6.0" maxSpeed="20.0" color="1,0,0" vClass="emergency"/>

    <!-- Primary Routes -->
    <route id="r_NS" edges="north_in south_out"/>
    <route id="r_NW" edges="north_in west_out"/>
    <route id="r_SN" edges="south_in north_out"/>
    <route id="r_SE" edges="south_in east_out"/>
    <route id="r_EW" edges="east_in west_out"/>
    <route id="r_EN" edges="east_in north_out"/>
    <route id="r_WE" edges="west_in east_out"/>
    <route id="r_WS" edges="west_in south_out"/>

    <!-- Precomputed Static Alternate Routes (for Route Recommendation when primary approach is congested) -->
    <route id="r_NS_alt1" edges="north_in west_out"/>
    <route id="r_SN_alt1" edges="south_in east_out"/>
    <route id="r_EW_alt1" edges="east_in north_out"/>
    <route id="r_WE_alt1" edges="west_in south_out"/>

    <!-- Regular Vehicle Flows (simulating dynamic traffic load) -->
    <!-- North-South Heavy Traffic Flow -->
    <flow id="flow_NS" type="passenger" route="r_NS" begin="0" end="300" period="4" departLane="0" departSpeed="max"/>
    <flow id="flow_SN" type="passenger" route="r_SN" begin="0" end="300" period="5" departLane="0" departSpeed="max"/>

    <!-- East-West Moderate Traffic Flow -->
    <flow id="flow_EW" type="passenger" route="r_EW" begin="0" end="300" period="8" departLane="0" departSpeed="max"/>
    <flow id="flow_WE" type="passenger" route="r_WE" begin="0" end="300" period="10" departLane="0" departSpeed="max"/>

    <!-- Scheduled Emergency Vehicles (Ambulances) -->
    <vehicle id="ambulance_NS_1" type="emergency" route="r_NS" depart="45" departLane="0" departSpeed="max"/>
    <vehicle id="ambulance_EW_1" type="emergency" route="r_EW" depart="130" departLane="0" departSpeed="max"/>

</routes>
